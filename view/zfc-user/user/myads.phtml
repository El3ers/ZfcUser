<script src="<?php echo $this->basePath() ?>/js/components/paginator/simplePagination.js"></script>
<script src="<?php echo $this->basePath() ?>/js/zfcuser/user.js"></script>
<script>
    var nbItems = <?php echo $this->nbAds; ?>;
    var perPage = 6;
    $(function () {
        $('.aPage_1').addClass('aPage_active')
        for (var i = 2; i < nbItems / perPage + 1; i++) {
            $('.aPage_' + i).hide();
        }
        $("#annonces-selector").pagination({
            items: nbItems,
            itemsOnPage: perPage,
            cssStyle: 'light-theme',
            onPageClick: function (pageNumber) {
                $('.aPage_active').hide('slow').removeClass('aPage_active');
                $('.aPage_' + pageNumber).show('slow').addClass('aPage_active');
            }
        });
    });
</script>
